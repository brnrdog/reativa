# PostHog analytics for the documentation site and the playground.
#
# Copy this file to website/.env.local to report from a local build, or set the
# same variables in the environment of the deploy (see .github/workflows/pages.yml).
# Without VITE_POSTHOG_KEY the site builds and runs with analytics switched off,
# which is what every clone and fork gets by default.
#
# The project API key is a public, write-only client key — it is meant to ship
# in the bundle, so it belongs in a repository variable rather than a secret.

# Project API key, from PostHog → Settings → Project → Project API key.
VITE_POSTHOG_KEY=

# API host for the project's region: https://us.i.posthog.com (default) or
# https://eu.i.posthog.com. Set it to your own domain if you front PostHog with
# a reverse proxy.
VITE_POSTHOG_HOST=https://us.i.posthog.com
