(* Platform and tools: Backends, Testing, Devtools and reativa-inspect. *)

open Doc

let code file ocaml reason = Code { file; ocaml; reason }

(* ----- Backends ----- *)

let backends () =
  [
    P
      "reativa compiles with either of OCaml's JavaScript compilers. The library, the markup and the ppx are the same; only three small modules underneath differ, and you choose by naming a library in dune.";
    Raw (Examples.backend_panels ());
    H2 ("melange", "Melange");
    Bullets
      [
        "`(libraries reativa)` selects it; it is the default.";
        "Each module becomes an ES module under `_build`. Bundle the entry with Vite or esbuild, which also drop the parts of the library you do not use.";
        "Bindings to JavaScript use Melange's attributes, like `[@@mel.send]`. Promises are `Js.Promise.t`.";
        "This site is built with Melange and Vite.";
      ];
    H2 ("jsoo", "js_of_ocaml");
    Bullets
      [
        "`(libraries reativa reativa-jsoo)` selects it. Pin `reativa-jsoo` from the same repository.";
        "The program links into one self-contained `.bc.js` script: no bundler, no npm step.";
        "Bindings to JavaScript use `Js_of_ocaml`. Promises are JavaScript promises.";
      ];
    H2 ("differences", "What differs");
    Bullets
      [
        "Only `Dom`, `History` and `Promise` are backend-specific. Everything else, from signals to the keyed list, is shared code.";
        "js_of_ocaml represents `None`, `false` and `0` as the same JavaScript value, so bare `bool` and `option` children are unsupported on both backends. Use `View.Show` and `View.Maybe`.";
        "The browser's stack is smaller than a native one; the library keeps hot paths tail-recursive, and your own deep recursion may need the same care under js_of_ocaml.";
        "[Async data](/docs/learn/async-data) takes each backend's own promises.";
      ];
  ]

(* ----- Testing ----- *)

let native_test_ml =
  {|(* test/test_cart.ml, run by `dune test` as a native program *)
open Reativa

let () =
  let items = Signal.make [ 3; 4 ] in
  let total = Computed.make (fun () -> List.fold_left ( + ) 0 (Signal.get items)) in
  assert (Signal.peek total = 7);
  Signal.update items (fun l -> 5 :: l);
  assert (Signal.peek total = 12)|}

let native_test_re =
  {|/* test/test_cart.re, run by `dune test` as a native program */
open Reativa;

let () = {
  let items = Signal.make([3, 4]);
  let total = Computed.make(() => List.fold_left((+), 0, Signal.get(items)));
  assert(Signal.peek(total) == 7);
  Signal.update(items, l => [5, ...l]);
  assert(Signal.peek(total) == 12);
};|}

let native_dune =
  {|(test
 (name test_cart)
 (libraries reativa))|}

let cost_ml =
  {|let () =
  Devtools.install ();
  let count = Signal.make 0 in
  let label = Computed.make (fun () -> string_of_int (Signal.get count)) in
  Effect.run (fun () -> ignore (Signal.get label); None);
  let trace = Devtools.record (fun () -> Signal.set count 1) in
  assert (trace.counts.runs = 1)|}

let cost_re =
  {|let () = {
  Devtools.install();
  let count = Signal.make(0);
  let label = Computed.make(() => string_of_int(Signal.get(count)));
  Effect.run(() => { ignore(Signal.get(label)); None });
  let trace = Devtools.record(() => Signal.set(count, 1));
  assert(trace.counts.runs == 1);
};|}

let testing () =
  [
    P
      "Most of what a UI decides lives in its state: what is derived from what, what a click changes. In reativa that is plain OCaml with no browser involved, so you can test it the way you test any OCaml code.";
    H2 ("native", "Test state natively");
    P
      "Signals, computeds and effects do not touch the DOM. A test that builds them and checks their values is an ordinary native executable:";
    code "test_cart.ml" native_test_ml native_test_re;
    Plain { file = "test/dune"; lang = "dune"; source = native_dune };
    P
      "Keep the logic of a feature in a module of signals and functions, and the markup in another: the first is tested natively, the second stays thin.";
    H2 ("cost", "Assert what an interaction costs");
    P
      "`Devtools.record` returns the writes, recomputes and effect runs one function caused. That turns a performance expectation into a test, for example that a write updates exactly one subscriber:";
    code "test_cost.ml" cost_ml cost_re;
    H2 ("end-to-end", "Drive the compiled app");
    P
      "For the DOM itself, `reativa-inspect run` loads your compiled app into jsdom, performs clicks, typing and key presses, and reports what each one changed. It exits with an error if the page raised one, so it fits in CI. See [Devtools and reativa-inspect](/docs/devtools).";
    Note
      "reativa's own test suite works the same way: the signal graph is tested natively, and the renderer is tested under jsdom on both backends, counting DOM operations.";
  ]

(* ----- Devtools and reativa-inspect ----- *)

let devtools_ml =
  {|open Reativa

let count = Signal.make ~name:"count" 0
let label = Computed.make ~name:"label" (fun () -> string_of_int (Signal.get count))

let () =
  Devtools.install ();   (* before creating what you want to see *)
  Devtools.expose ();    (* for reativa-inspect *)
  View.mount_by_id "app" app|}

let devtools_re =
  {|open Reativa;

let count = Signal.make(~name="count", 0);
let label = Computed.make(~name="label", () => string_of_int(Signal.get(count)));

let () = {
  Devtools.install(); /* before creating what you want to see */
  Devtools.expose(); /* for reativa-inspect */
  View.mount_by_id("app", app);
};|}

let inspect_cli =
  {|reativa-inspect run _build/default/app.bc.js \
  --act "click #inc" --act "type #name Ada" --why "#greeting"

reativa-inspect mcp    # the same, as an MCP server for coding agents|}

let panel_ml = {|let unmount = Reativa_devtools.Panel.mount ()|}
let panel_re = {|let unmount = Reativa_devtools.Panel.mount();|}

let devtools () =
  [
    P
      "Fine-grained updates are fast because little happens. Devtools show you exactly what that little is: every signal write, recompute and effect run, and for any DOM node, the chain of updates that made it show what it shows.";
    H2 ("install", "Install");
    P
      "Call `Devtools.install ()` before creating the signals you want to see; nodes created earlier are not tracked. Give signals a `~name` to read the reports. Until it is installed, the cost is one boolean test per update, and an app that never mentions `Devtools` does not ship it.";
    code "main.mlx" devtools_ml devtools_re;
    H2 ("api", "Ask questions in code");
    Terms
      [
        ("Devtools.record f", "The events and counts (writes, recomputes, runs) caused by running `f`.");
        ("Devtools.why id", "The chain from an effect back to the signal write that caused its last run.");
        ("Devtools.writers_of node", "The effects that write a DOM node; `effects_writing` names them.");
        ("Devtools.snapshot ()", "Every live signal, computed and effect, with its subscribers and dependencies; `Devtools.value id` previews a value.");
        ("Devtools.leaks ()", "Effects that read nothing and so can never run again.");
      ];
    H2 ("panel", "The in-page panel");
    P
      "The `reativa.devtools` library adds a panel to the page: live counts, the latest events, leaks, and an inspect mode that explains the element you click.";
    code "dev.mlx" panel_ml panel_re;
    H2 ("inspect", "reativa-inspect");
    P
      "`reativa-inspect` drives the compiled app headlessly. It loads the bundle into jsdom with an empty `<div id=\"app\">`, so the app must call `Devtools.expose ()` and mount there. For each action it reports the writes, recomputes and runs, and the DOM nodes that changed; `--why` explains an element; every report ends with the leak check.";
    Plain { file = "shell"; lang = "shell"; source = inspect_cli };
    P
      "As an MCP server, the same tool lets a coding agent click through your app and check that a change did what it meant to, without a browser.";
  ]
