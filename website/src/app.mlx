(* The reativa documentation site — written in reativa itself.

   Every live demo on this page is the library running for real: signals hold
   the state, and the exact text nodes, attributes and regions that read them
   update in place. Code blocks are static views; a tiny highlighter in
   main.js colors them once after mount. *)

open Reativa
open Reativa.View.Mlx

(* ----- browser bindings used only by the docs site ----- *)

external copy_text : string -> unit = "writeText"
  [@@mel.scope ("navigator", "clipboard")]

external set_timeout : (unit -> unit) -> int -> unit = "setTimeout"
external set_interval : (unit -> unit) -> int -> float = "setInterval"
external clear_interval : float -> unit = "clearInterval"

(* ----- color theme: light / dark ----- *)

(* index.html seeds [data-theme] on <html> before first paint (from
   localStorage or the OS preference). We read it back to align the signal,
   then keep the attribute - and the stored choice - in sync as it changes. *)

external query_selector : string -> Dom.t = "querySelector" [@@mel.scope "document"]

external get_attribute : Dom.t -> string -> string option = "getAttribute"
  [@@mel.send] [@@mel.return nullable]

external store_item : string -> string -> unit = "setItem"
  [@@mel.scope "localStorage"]

external read_item : string -> string option = "getItem"
  [@@mel.scope "localStorage"] [@@mel.return nullable]

let stored key = try read_item key with _ -> None
let remember key value = try store_item key value with _ -> ()

type theme = Light | Dark

let root_el = query_selector "html"

let initial_theme =
  match get_attribute root_el "data-theme" with Some "dark" -> Dark | _ -> Light

let theme = Signal.make initial_theme

let () =
  Effect.run (fun () ->
    let name = match Signal.get theme with Dark -> "dark" | Light -> "light" in
    Dom.set_attribute root_el "data-theme" name;
    remember "theme" name;
    None)

let toggle_theme _ = Signal.update theme (function Light -> Dark | Dark -> Light)

(* ----- syntax toggle: OCaml (mlx) vs ReasonML (re) ----- *)

(* Neither syntax is the "real" one: the two render the same library, and the
   choice is remembered so a ReasonML reader keeps ReasonML across visits. *)

type syntax = OCaml | Reason

let initial_syntax =
  match stored "syntax" with Some "reason" -> Reason | _ -> OCaml

let syntax = Signal.make initial_syntax

let () =
  Effect.run (fun () ->
    remember "syntax"
      (match Signal.get syntax with Reason -> "reason" | OCaml -> "ocaml");
    None)

(* Turn an mlx filename into its ReasonML counterpart: foo.mlx -> foo.re. *)
let reason_file file =
  match String.rindex_opt file '.' with
  | Some i -> String.sub file 0 i ^ ".re"
  | None -> file ^ ".re"

(* ----- copy-to-clipboard feedback ----- *)

let copied = Signal.make ""

let copy_code id source =
  (try copy_text source with _ -> ());
  Signal.set copied id;
  set_timeout
    (fun () -> if Signal.peek copied = id then Signal.set copied "")
    1600

(* ----- building blocks ----- *)

let code_panel ~id ~file ~lang source =
  <figure className="code-panel">
    <figcaption className="code-panel-bar">
      <span className="code-file">(file)</span>
      <button
        className=(if Signal.get copied = id then "copy-btn is-copied" else "copy-btn")
        aria_label="Copy code to clipboard"
        onClick=(fun _ -> copy_code id source)
      >
        (if Signal.get copied = id then "Copied!" else "Copy")
      </button>
    </figcaption>
    <pre className=("code-body " ^ lang)><code>(source)</code></pre>
  </figure>

(* A code panel that carries both an OCaml and a ReasonML rendering of the same
   thing. Both are mounted once so the highlighter in main.js colors each in a
   single pass; the active syntax signal only flips which one is shown (via
   CSS) and which one the Copy button reads. [lang_ml] and [lang_re] pick the
   highlighter for each side, [file_re] the filename shown for ReasonML. *)
let code_panel_pair ~id ~file ~file_re ~lang_ml ~lang_re ~ocaml ~reason =
  <figure
    className=(if Signal.get syntax = Reason then "code-panel is-reason" else "code-panel")
  >
    <figcaption className="code-panel-bar">
      <span className="code-file">
        (if Signal.get syntax = Reason then file_re else file)
      </span>
      <button
        className=(if Signal.get copied = id then "copy-btn is-copied" else "copy-btn")
        aria_label="Copy code to clipboard"
        onClick=(fun _ ->
          copy_code id (if Signal.peek syntax = Reason then reason else ocaml))
      >
        (if Signal.get copied = id then "Copied!" else "Copy")
      </button>
    </figcaption>
    <pre className=("code-body syntax-ml " ^ lang_ml)><code>(ocaml)</code></pre>
    <pre className=("code-body syntax-re " ^ lang_re)><code>(reason)</code></pre>
  </figure>

(* Two renderings of the same program: .mlx source against .re source. *)
let code_panel_ml ~id ~file ~ocaml ~reason =
  code_panel_pair ~id ~file ~file_re:(reason_file file) ~lang_ml:"ocaml"
    ~lang_re:"reason" ~ocaml ~reason

(* Setup that differs by syntax without being OCaml or ReasonML itself: the
   same file, the same highlighter, two contents. *)
let code_panel_setup ~id ~file ~lang ~ocaml ~reason =
  code_panel_pair ~id ~file ~file_re:file ~lang_ml:lang ~lang_re:lang ~ocaml
    ~reason

let section_head kicker title lede =
  <header className="section-head">
    <p className="kicker">(kicker)</p>
    <h2>(title)</h2>
    <p className="lede">(lede)</p>
  </header>

(* Examples are shown one at a time. Every one of them is mounted, so the
   highlighter in main.js colors them all in its single pass; the active tab
   only flips which article carries [is-active]. *)
let active_example = Signal.make "counter"

let example_tab ~tab label =
  <button
    className=(if Signal.get active_example = tab then "example-tab is-active" else "example-tab")
    aria_pressed=(if Signal.get active_example = tab then "true" else "false")
    onClick=(fun _ -> Signal.set active_example tab)
  >
    (label)
  </button>

let example ~id ~tab ~title ~intro ~file ~code ~code_re demo =
  <article
    id=(id)
    className=(if Signal.get active_example = tab then "example is-active" else "example")
  >
    <div className="example-info">
      <h3>(title)</h3>
      <p>(intro)</p>
    </div>
    <div className="example-panes">
      (code_panel_ml ~id ~file ~ocaml:code ~reason:code_re)
      <aside className="example-demo">
        <span className="demo-tag">("Live demo")</span>
        <div className="demo-stage">(demo)</div>
      </aside>
    </div>
  </article>

(* A short snippet inside a card, in both syntaxes; the header switch picks
   which one shows. *)
let mini_pair ~ocaml ~reason =
  <div className=(if Signal.get syntax = Reason then "mini-pair is-reason" else "mini-pair")>
    <pre className="mini syntax-ml ocaml"><code>(ocaml)</code></pre>
    <pre className="mini syntax-re reason"><code>(reason)</code></pre>
  </div>

let new_item title body =
  <article className="new-item">
    <h3>(title)</h3>
    <p>(body)</p>
  </article>

let api_row signature description =
  <div className="api-row">
    <dt><code>(signature)</code></dt>
    <dd>(description)</dd>
  </div>

let api_group ~id ~name ~blurb rows =
  <article id=(id) className="api-group">
    <h3><code>(name)</code></h3>
    <p className="api-blurb">(blurb)</p>
    <dl className="api-rows">(View.fragment rows)</dl>
  </article>

let step number title body content =
  <article className="step">
    <span className="step-num">(number)</span>
    <div className="step-copy">
      <h3>(title)</h3>
      <p>(body)</p>
    </div>
    (content)
  </article>

(* ================================================================== *)
(* Example 1 — counter: signals and computed values                    *)
(* ================================================================== *)

let count = Signal.make 0
let doubled = Computed.make (fun () -> Signal.get count * 2)

let counter_code =
  {|open Reativa
open Reativa.View.Mlx

let count = Signal.make 0
let doubled = Computed.make (fun () -> Signal.get count * 2)

let () =
  View.mount_by_id "app"
    <div className="counter">
      <p className="value">(Signal.get count)</p>
      <p>("doubled is ") (Signal.get doubled)</p>
      <div className="row">
        <button onClick=(fun _ -> Signal.update count (fun n -> n - 1))>
          ("-1")
        </button>
        <button onClick=(fun _ -> Signal.update count (fun n -> n + 1))>
          ("+1")
        </button>
        <button onClick=(fun _ -> Signal.set count 0)>("Reset")</button>
      </div>
    </div>|}

let counter_code_re =
  {|open Reativa;
open Reativa.View.Mlx;

let count = Signal.make(0);
let doubled = Computed.make(() => Signal.get(count) * 2);

let () =
  View.mount_by_id(
    "app",
    <div className="counter">
      <p className="value"> {Signal.get(count)} </p>
      <p> {"doubled is "} {Signal.get(doubled)} </p>
      <div className="row">
        <button onClick={_ => Signal.update(count, n => n - 1)}>
          {"-1"}
        </button>
        <button onClick={_ => Signal.update(count, n => n + 1)}>
          {"+1"}
        </button>
        <button onClick={_ => Signal.set(count, 0)}> {"Reset"} </button>
      </div>
    </div>,
  );|}

let counter_demo =
  <div className="counter-demo">
    <p className="big-value">(Signal.get count)</p>
    <p className="demo-sub">
      ("doubled is ") <strong>(Signal.get doubled)</strong>
    </p>
    <div className="btn-row">
      <button
        className="btn small"
        onClick=(fun _ -> Signal.update count (fun n -> n - 1))
      >
        ("-1")
      </button>
      <button
        className="btn small"
        onClick=(fun _ -> Signal.update count (fun n -> n + 1))
      >
        ("+1")
      </button>
      <button className="btn small ghost" onClick=(fun _ -> Signal.set count 0)>
        ("Reset")
      </button>
    </div>
  </div>

(* ================================================================== *)
(* Example 2 — todos: keyed lists, forms and reactive inputs           *)
(* ================================================================== *)

type todo = { todo_id : int; title : string; done_ : bool }

let todos =
  Signal.make
    [
      { todo_id = 1; title = "Read the signals guide"; done_ = true };
      { todo_id = 2; title = "Build something reactive"; done_ = false };
    ]

let next_id = Signal.make 3
let draft = Signal.make ""

let remaining =
  Computed.make (fun () ->
    Signal.get todos |> List.filter (fun t -> not t.done_) |> List.length)

let add_todo ev =
  Dom.prevent_default ev;
  let title = String.trim (Signal.peek draft) in
  if title <> "" then begin
    let todo_id = Signal.peek next_id in
    Signal.update todos (fun items ->
      items @ [ { todo_id; title; done_ = false } ]);
    Signal.set next_id (todo_id + 1);
    Signal.set draft ""
  end

let toggle_todo id =
  Signal.update todos (fun items ->
    List.map
      (fun t -> if t.todo_id = id then { t with done_ = not t.done_ } else t)
      items)

let todos_code =
  {|open Reativa
open Reativa.View.Mlx

type todo = { id : int; title : string; done_ : bool }

let todos =
  Signal.make
    [
      { id = 1; title = "Read the signals guide"; done_ = true };
      { id = 2; title = "Build something reactive"; done_ = false };
    ]

let next_id = Signal.make 3
let draft = Signal.make ""

let remaining =
  Computed.make (fun () ->
    Signal.get todos |> List.filter (fun t -> not t.done_) |> List.length)

let add_todo ev =
  Dom.prevent_default ev;
  let title = String.trim (Signal.peek draft) in
  if title <> "" then begin
    let id = Signal.peek next_id in
    Signal.update todos (fun items -> items @ [ { id; title; done_ = false } ]);
    Signal.set next_id (id + 1);
    Signal.set draft ""
  end

let toggle id =
  Signal.update todos (fun items ->
    List.map
      (fun t -> if t.id = id then { t with done_ = not t.done_ } else t)
      items)

let () =
  View.mount_by_id "app"
    <div className="todos">
      <form onSubmit=add_todo>
        <input
          placeholder="What needs doing?"
          value=(Signal.get draft)
          onInput=(fun ev -> Signal.set draft (Dom.target_value ev))
        />
        <button disabled=(String.trim (Signal.get draft) = "")>("Add")</button>
      </form>

      <ul>
        <View.ForEach
          items=(fun () -> Signal.get todos)
          key=(fun t -> string_of_int t.id)
          render=(fun t ->
            <li>
              <label>
                <input
                  type_="checkbox"
                  checked=(t.done_)
                  onChange=(fun _ -> toggle t.id)
                />
                <span>(t.title)</span>
              </label>
            </li>)
        />
      </ul>

      <p>(Signal.get remaining) (" left to do")</p>
    </div>|}

let todos_code_re =
  {|open Reativa;
open Reativa.View.Mlx;

type todo = {
  id: int,
  title: string,
  done_: bool,
};

let todos =
  Signal.make([
    {id: 1, title: "Read the signals guide", done_: true},
    {id: 2, title: "Build something reactive", done_: false},
  ]);

let next_id = Signal.make(3);
let draft = Signal.make("");

let remaining =
  Computed.make(() =>
    Signal.get(todos) |> List.filter(t => !t.done_) |> List.length
  );

let add_todo = ev => {
  Dom.prevent_default(ev);
  let title = String.trim(Signal.peek(draft));
  if (title != "") {
    let id = Signal.peek(next_id);
    Signal.update(todos, items => items @ [{id, title, done_: false}]);
    Signal.set(next_id, id + 1);
    Signal.set(draft, "");
  };
};

let toggle = id =>
  Signal.update(todos, items =>
    List.map(t => t.id == id ? {...t, done_: !t.done_} : t, items)
  );

let () =
  View.mount_by_id(
    "app",
    <div className="todos">
      <form onSubmit=add_todo>
        <input
          placeholder="What needs doing?"
          value={Signal.get(draft)}
          onInput={ev => Signal.set(draft, Dom.target_value(ev))}
        />
        <button disabled={String.trim(Signal.get(draft)) == ""}>
          {"Add"}
        </button>
      </form>

      <ul>
        <View.ForEach
          items={() => Signal.get(todos)}
          key={t => string_of_int(t.id)}
          render={t =>
            <li>
              <label>
                <input
                  type_="checkbox"
                  checked={t.done_}
                  onChange={_ => toggle(t.id)}
                />
                <span> {t.title} </span>
              </label>
            </li>
          }
        />
      </ul>

      <p> {Signal.get(remaining)} {" left to do"} </p>
    </div>,
  );|}

let todos_demo =
  <div className="todo-demo">
    <form className="todo-form" onSubmit=add_todo>
      <input
        className="field"
        placeholder="What needs doing?"
        value=(Signal.get draft)
        onInput=(fun ev -> Signal.set draft (Dom.target_value ev))
      />
      <button
        className="btn small"
        disabled=(String.trim (Signal.get draft) = "")
      >
        ("Add")
      </button>
    </form>
    <ul className="todo-items">
      <View.ForEach
        items=(fun () -> Signal.get todos)
        key=(fun t -> string_of_int t.todo_id)
        render=(fun t ->
          <li className="todo-item">
            <label className=(if t.done_ then "todo-label done" else "todo-label")>
              <input
                type_="checkbox"
                checked=(t.done_)
                onChange=(fun _ -> toggle_todo t.todo_id)
              />
              <span>(t.title)</span>
            </label>
          </li>)
      />
    </ul>
    <p className="demo-sub">(Signal.get remaining) (" left to do")</p>
  </div>

(* ================================================================== *)
(* Example 3 — conditional rendering with Show and Maybe               *)
(* ================================================================== *)

let logged_in = Signal.make false
let topic : string option Signal.t = Signal.make None

let show_code =
  {|open Reativa
open Reativa.View.Mlx

let logged_in = Signal.make false
let topic : string option Signal.t = Signal.make None

let () =
  View.mount_by_id "app"
    <div className="panel">
      <div className="row">
        <button onClick=(fun _ -> Signal.update logged_in not)>
          (if Signal.get logged_in then "Sign out" else "Sign in")
        </button>
        <button onClick=(fun _ -> Signal.set topic (Some "signals"))>
          ("Pick a topic")
        </button>
        <button onClick=(fun _ -> Signal.set topic None)>("Clear")</button>
      </div>

      <View.Show
        condition=(fun () -> Signal.get logged_in)
        fallback=(<p>("Signed out. Sign in to see your greeting.")</p>)
      >
        <p>("Welcome back!")</p>
      </View.Show>

      <View.Maybe
        value=(fun () -> Signal.get topic)
        fallback=(<p>("No topic selected.")</p>)
        render=(fun topic ->
          <p>("Reading about ") <strong>(topic)</strong> (".")</p>)
      />
    </div>|}

let show_code_re =
  {|open Reativa;
open Reativa.View.Mlx;

let logged_in = Signal.make(false);
let topic: Signal.t(option(string)) = Signal.make(None);

let () =
  View.mount_by_id(
    "app",
    <div className="panel">
      <div className="row">
        <button onClick={_ => Signal.update(logged_in, b => !b)}>
          {Signal.get(logged_in) ? "Sign out" : "Sign in"}
        </button>
        <button onClick={_ => Signal.set(topic, Some("signals"))}>
          {"Pick a topic"}
        </button>
        <button onClick={_ => Signal.set(topic, None)}> {"Clear"} </button>
      </div>

      <View.Show
        condition={() => Signal.get(logged_in)}
        fallback={<p> {"Signed out. Sign in to see your greeting."} </p>}>
        <p> {"Welcome back!"} </p>
      </View.Show>

      <View.Maybe
        value={() => Signal.get(topic)}
        fallback={<p> {"No topic selected."} </p>}
        render={topic =>
          <p> {"Reading about "} <strong> {topic} </strong> {"."} </p>
        }
      />
    </div>,
  );|}

let show_demo =
  <div className="show-demo">
    <div className="btn-row">
      <button className="btn small" onClick=(fun _ -> Signal.update logged_in not)>
        (if Signal.get logged_in then "Sign out" else "Sign in")
      </button>
      <button
        className="btn small ghost"
        onClick=(fun _ -> Signal.set topic (Some "signals"))
      >
        ("Pick a topic")
      </button>
      <button className="btn small ghost" onClick=(fun _ -> Signal.set topic None)>
        ("Clear")
      </button>
    </div>
    <View.Show
      condition=(fun () -> Signal.get logged_in)
      fallback=(<p className="status muted">("Signed out. Sign in to see your greeting.")</p>)
    >
      <p className="status">("Welcome back!")</p>
    </View.Show>
    <View.Maybe
      value=(fun () -> Signal.get topic)
      fallback=(<p className="status muted">("No topic selected.")</p>)
      render=(fun topic ->
        <p className="status">("Reading about ") <strong>(topic)</strong> (".")</p>)
    />
  </div>

(* ================================================================== *)
(* Example 4 — stopwatch: effects with cleanup                         *)
(* ================================================================== *)

let tenths = Signal.make 0
let running = Signal.make false

let () =
  Effect.run (fun () ->
    if Signal.get running then begin
      let id =
        set_interval (fun () -> Signal.update tenths (fun n -> n + 1)) 100
      in
      Some (fun () -> clear_interval id)
    end
    else None)

let stopwatch_code =
  {|open Reativa
open Reativa.View.Mlx

external set_interval : (unit -> unit) -> int -> float = "setInterval"
external clear_interval : float -> unit = "clearInterval"

let tenths = Signal.make 0
let running = Signal.make false

(* The effect re-runs when [running] flips. Its cleanup stops the
   previous interval first - that is the whole lifecycle. *)
let () =
  Effect.run (fun () ->
    if Signal.get running then begin
      let id =
        set_interval (fun () -> Signal.update tenths (fun n -> n + 1)) 100
      in
      Some (fun () -> clear_interval id)
    end
    else None)

let () =
  View.mount_by_id "app"
    <div className="stopwatch">
      <p className="time">
        (let n = Signal.get tenths in
         Printf.sprintf "%d.%ds" (n / 10) (n mod 10))
      </p>
      <div className="row">
        <button onClick=(fun _ -> Signal.update running not)>
          (if Signal.get running then "Pause" else "Start")
        </button>
        <button onClick=(fun _ -> Signal.set tenths 0)>("Reset")</button>
      </div>
    </div>|}

let stopwatch_code_re =
  {|open Reativa;
open Reativa.View.Mlx;

external set_interval: (unit => unit, int) => float = "setInterval";
external clear_interval: float => unit = "clearInterval";

let tenths = Signal.make(0);
let running = Signal.make(false);

/* The effect re-runs when [running] flips. Its cleanup stops the
   previous interval first - that is the whole lifecycle. */
let () =
  Effect.run(() =>
    if (Signal.get(running)) {
      let id = set_interval(() => Signal.update(tenths, n => n + 1), 100);
      Some(() => clear_interval(id));
    } else {
      None;
    }
  );

let () =
  View.mount_by_id(
    "app",
    <div className="stopwatch">
      <p className="time">
        {let n = Signal.get(tenths);
         Printf.sprintf("%d.%ds", n / 10, n mod 10)}
      </p>
      <div className="row">
        <button onClick={_ => Signal.update(running, b => !b)}>
          {Signal.get(running) ? "Pause" : "Start"}
        </button>
        <button onClick={_ => Signal.set(tenths, 0)}> {"Reset"} </button>
      </div>
    </div>,
  );|}

let stopwatch_demo =
  <div className="stopwatch-demo">
    <p className="big-value">
      (let n = Signal.get tenths in
       Printf.sprintf "%d.%ds" (n / 10) (n mod 10))
    </p>
    <div className="btn-row">
      <button className="btn small" onClick=(fun _ -> Signal.update running not)>
        (if Signal.get running then "Pause" else "Start")
      </button>
      <button className="btn small ghost" onClick=(fun _ -> Signal.set tenths 0)>
        ("Reset")
      </button>
    </div>
  </div>

(* ================================================================== *)
(* Example 5 — weather: fetching async data into signals               *)
(* ================================================================== *)

type response
type payload
type current

external fetch : string -> response Js.Promise.t = "fetch"
external json : response -> payload Js.Promise.t = "json" [@@mel.send]
external current_weather : payload -> current = "current_weather" [@@mel.get]
external temperature : current -> float = "temperature" [@@mel.get]
external windspeed : current -> float = "windspeed" [@@mel.get]
external random : unit -> float = "random" [@@mel.scope "Math"]

type city = { name : string; lat : string; lon : string }

let cities =
  [|
    { name = "Lisbon"; lat = "38.72"; lon = "-9.14" };
    { name = "Tokyo"; lat = "35.68"; lon = "139.69" };
    { name = "Nairobi"; lat = "-1.29"; lon = "36.82" };
    { name = "Reykjavik"; lat = "64.15"; lon = "-21.94" };
    { name = "Sydney"; lat = "-33.87"; lon = "151.21" };
    { name = "Cusco"; lat = "-13.53"; lon = "-71.97" };
  |]

type weather_state =
  | Idle
  | Loading of city
  | Loaded of city * float * float
  | Failed of city

let weather = Signal.make Idle

let fetch_weather _ =
  let city =
    cities.(int_of_float (random () *. float_of_int (Array.length cities)))
  in
  Signal.set weather (Loading city);
  let url =
    Printf.sprintf
      "https://api.open-meteo.com/v1/forecast?latitude=%s&longitude=%s&current_weather=true"
      city.lat city.lon
  in
  ignore
    (fetch url
    |> Js.Promise.then_ json
    |> Js.Promise.then_ (fun payload ->
         let current = current_weather payload in
         Signal.set weather
           (Loaded (city, temperature current, windspeed current));
         Js.Promise.resolve ())
    |> Js.Promise.catch (fun _ ->
         Signal.set weather (Failed city);
         Js.Promise.resolve ()))

let weather_code =
  {|open Reativa
open Reativa.View.Mlx

(* Bindings for fetch and the shape of the Open-Meteo response. *)
type response
type payload
type current

external fetch : string -> response Js.Promise.t = "fetch"
external json : response -> payload Js.Promise.t = "json" [@@mel.send]
external current_weather : payload -> current = "current_weather" [@@mel.get]
external temperature : current -> float = "temperature" [@@mel.get]
external windspeed : current -> float = "windspeed" [@@mel.get]
external random : unit -> float = "random" [@@mel.scope "Math"]

type city = { name : string; lat : string; lon : string }

let cities =
  [|
    { name = "Lisbon"; lat = "38.72"; lon = "-9.14" };
    { name = "Tokyo"; lat = "35.68"; lon = "139.69" };
    { name = "Nairobi"; lat = "-1.29"; lon = "36.82" };
    { name = "Reykjavik"; lat = "64.15"; lon = "-21.94" };
    { name = "Sydney"; lat = "-33.87"; lon = "151.21" };
    { name = "Cusco"; lat = "-13.53"; lon = "-71.97" };
  |]

type state =
  | Idle
  | Loading of city
  | Loaded of city * float * float
  | Failed of city

let weather = Signal.make Idle

let fetch_weather _ =
  let city =
    cities.(int_of_float (random () *. float_of_int (Array.length cities)))
  in
  Signal.set weather (Loading city);
  let url =
    Printf.sprintf
      "https://api.open-meteo.com/v1/forecast?latitude=%s&longitude=%s&current_weather=true"
      city.lat city.lon
  in
  ignore
    (fetch url
    |> Js.Promise.then_ json
    |> Js.Promise.then_ (fun payload ->
         let current = current_weather payload in
         Signal.set weather
           (Loaded (city, temperature current, windspeed current));
         Js.Promise.resolve ())
    |> Js.Promise.catch (fun _ ->
         Signal.set weather (Failed city);
         Js.Promise.resolve ()))

let () =
  View.mount_by_id "app"
    <div className="weather">
      <button onClick=fetch_weather>("Check a random city")</button>
      (View.tracked (fun () ->
         match Signal.get weather with
         | Idle -> <p>("Real weather, one click away.")</p>
         | Loading city -> <p>(Printf.sprintf "Checking %s..." city.name)</p>
         | Failed city ->
           <p>(Printf.sprintf "Could not reach the service for %s." city.name)</p>
         | Loaded (city, temp, wind) ->
           <div>
             <h3>(city.name)</h3>
             <p>(temp) (" C now, wind ") (wind) (" km/h")</p>
           </div>))
    </div>|}

let weather_code_re =
  {|open Reativa;
open Reativa.View.Mlx;

/* Bindings for fetch and the shape of the Open-Meteo response. */
type response;
type payload;
type current;

external fetch: string => Js.Promise.t(response) = "fetch";
[@mel.send] external json: response => Js.Promise.t(payload) = "json";
[@mel.get] external current_weather: payload => current = "current_weather";
[@mel.get] external temperature: current => float = "temperature";
[@mel.get] external windspeed: current => float = "windspeed";
[@mel.scope "Math"] external random: unit => float = "random";

type city = {
  name: string,
  lat: string,
  lon: string,
};

let cities = [|
  {name: "Lisbon", lat: "38.72", lon: "-9.14"},
  {name: "Tokyo", lat: "35.68", lon: "139.69"},
  {name: "Nairobi", lat: "-1.29", lon: "36.82"},
  {name: "Reykjavik", lat: "64.15", lon: "-21.94"},
  {name: "Sydney", lat: "-33.87", lon: "151.21"},
  {name: "Cusco", lat: "-13.53", lon: "-71.97"},
|];

type state =
  | Idle
  | Loading(city)
  | Loaded(city, float, float)
  | Failed(city);

let weather = Signal.make(Idle);

let fetch_weather = _ => {
  let city =
    cities[int_of_float(random() *. float_of_int(Array.length(cities)))];
  Signal.set(weather, Loading(city));
  let url =
    Printf.sprintf(
      "https://api.open-meteo.com/v1/forecast?latitude=%s&longitude=%s&current_weather=true",
      city.lat,
      city.lon,
    );
  ignore(
    fetch(url)
    |> Js.Promise.then_(json)
    |> Js.Promise.then_(payload => {
         let current = current_weather(payload);
         Signal.set(
           weather,
           Loaded(city, temperature(current), windspeed(current)),
         );
         Js.Promise.resolve();
       })
    |> Js.Promise.catch(_ => {
         Signal.set(weather, Failed(city));
         Js.Promise.resolve();
       }),
  );
};

let () =
  View.mount_by_id(
    "app",
    <div className="weather">
      <button onClick=fetch_weather> {"Check a random city"} </button>
      {View.tracked(() =>
         switch (Signal.get(weather)) {
         | Idle => <p> {"Real weather, one click away."} </p>
         | Loading(city) =>
           <p> {Printf.sprintf("Checking %s...", city.name)} </p>
         | Failed(city) =>
           <p>
             {Printf.sprintf("Could not reach the service for %s.", city.name)}
           </p>
         | Loaded(city, temp, wind) =>
           <div>
             <h3> {city.name} </h3>
             <p> {temp} {" C now, wind "} {wind} {" km/h"} </p>
           </div>
         }
       )}
    </div>,
  );|}

let weather_demo =
  <div className="weather-demo">
    <button className="btn small" onClick=fetch_weather>
      ("Check a random city")
    </button>
    (View.tracked (fun () ->
       match Signal.get weather with
       | Idle ->
         <p className="status muted">("Real weather, one click away.")</p>
       | Loading city ->
         <p className="status muted">(Printf.sprintf "Checking %s..." city.name)</p>
       | Failed city ->
         <p className="status muted">
           (Printf.sprintf "Could not reach the service for %s." city.name)
         </p>
       | Loaded (city, temp, wind) ->
         <div className="weather-card">
           <h3>(city.name)</h3>
           <p className="weather-line">
             <strong>(temp)</strong>
             (" C now, wind ")
             <strong>(wind)</strong>
             (" km/h")
           </p>
         </div>))
  </div>

(* ================================================================== *)
(* Static code snippets                                                *)
(* ================================================================== *)

let hero_name = Signal.make "world"

let hero_shout =
  Computed.make ~equals:String.equal (fun () ->
    String.uppercase_ascii (Signal.get hero_name))

(* The two counters under the hero demo. They are instrumentation, not part
   of the program shown above it: one counts writes to the name signal, the
   other counts the times the greeting's text node had to change. *)
let name_writes = Signal.make 0
let greeting_updates = Signal.make 0

let () =
  let first = ref true in
  Effect.run (fun () ->
    ignore (Signal.get hero_shout);
    if !first then first := false
    else Signal.update greeting_updates (fun n -> n + 1);
    None)

let on_hero_input ev =
  Signal.set hero_name (Dom.target_value ev);
  Signal.update name_writes (fun n -> n + 1)

(* The graph in "How it works": a signal, a computed, and the text nodes that
   read them. *)
let graph_count = Signal.make 2
let graph_double = Computed.make (fun () -> Signal.get graph_count * 2)

let hero_code =
  {|open Reativa
open Reativa.View.Mlx

let name = Signal.make "world"
let shout =
  Computed.make ~equals:String.equal (fun () ->
    String.uppercase_ascii (Signal.get name))

let () =
  View.mount_by_id "app"
    <section>
      <input
        value=(Signal.get name)
        onInput=(fun ev -> Signal.set name (Dom.target_value ev))
      />
      <h1>("Hello, ") (Signal.get shout) ("!")</h1>
    </section>|}

let hero_code_re =
  {|open Reativa;
open Reativa.View.Mlx;

let name = Signal.make("world");
let shout =
  Computed.make(~equals=String.equal, () =>
    String.uppercase_ascii(Signal.get(name))
  );

let () =
  View.mount_by_id(
    "app",
    <section>
      <input
        value={Signal.get(name)}
        onInput={ev => Signal.set(name, Dom.target_value(ev))}
      />
      <h1> {"Hello, "} {Signal.get(shout)} {"!"} </h1>
    </section>,
  );|}

let install_code = {|opam pin add reativa https://github.com/brnrdog/reativa.git|}

let install_code_re =
  {|opam pin add reativa https://github.com/brnrdog/reativa.git
opam install reason|}

let dune_project_code =
  {|(lang dune 3.16)

; Needed by the melange.emit stanza; a js_of_ocaml-only project can drop it.
(using melange 0.1)

(dialect
 (name mlx)
 (implementation
  (extension mlx)
  (merlin_reader mlx)
  (preprocess
   (run mlx-pp %{input-file}))))|}

let dune_project_code_re =
  {|(lang dune 3.16)

; Needed by the melange.emit stanza; a js_of_ocaml-only project can drop it.
(using melange 0.1)

; Nothing else to declare: dune reads .re files out of the box
; once the reason package is in your switch.|}

let dune_melange_code =
  {|(melange.emit
 (target output)
 (libraries reativa)
 (preprocess
  (pps reativa.mlx_ppx melange.ppx))
 (module_systems es6))|}

let dune_jsoo_code =
  {|(executables
 (names app)
 (modes js)
 (libraries reativa reativa-jsoo)
 (preprocess
  (pps reativa.mlx_ppx)))|}

(* The two backends side by side: the stanza is the only thing that differs
   between them, so neither gets to be the one on the page. *)
