      <span className="step-panel-label">("Melange")</span>
      (code_panel ~id:"dune-melange" ~file:"src/dune" ~lang:"dune"
         dune_melange_code)
    </div>
    <div className="step-panel">
      <span className="step-panel-label">("js_of_ocaml")</span>
      (code_panel ~id:"dune-jsoo" ~file:"src/dune" ~lang:"dune" dune_jsoo_code)
    </div>
  </div>

