(* The reativa site - written in reativa itself.

   This module is the shell: the header, the footer, and the outlet that maps
   the current route to a page. The pages live in home.mlx, examples_page.mlx
   and the docs modules (docs_layout.mlx renders them from the registry in
   docs_index.ml). Every live demo is the library running for real; code
   blocks are colored by main.js as they appear. *)

open Reativa
open Reativa.View.Mlx

let text = Ui.text

(* ----- not found ----- *)

let not_found () =
  <div className="page-wrap not-found">
    <p className="kicker">("404")</p>
    <h1>("This page does not exist")</h1>
    <p className="lede">("It may have moved when the docs were reorganised.")</p>
    <div className="hero-actions">
      (Site.link ~className:"btn primary" "/docs" [ text "Go to the docs" ])
      (Site.link ~className:"btn ghost" "/" [ text "Home" ])
    </div>
  </div>

(* ----- routes ----- *)

type area = On_home | On_examples | On_docs | Missing

(* Which part of the site the route is in. The outlet below rebuilds only when
   this changes, so moving between docs pages keeps the docs layout mounted. *)
let area =
  Computed.make (fun () ->
    match Signal.get Site.route with
    | "/" -> On_home
    | "/examples" -> On_examples
    | path -> if Option.is_some (Docs_index.find path) then On_docs else Missing)

let outlet () =
  View.dyn (fun () ->
    match Signal.get area with
    | On_home -> Home.page ()
    | On_examples -> Examples_page.page ()
    | On_docs -> Docs_layout.view ()
    | Missing -> not_found ())

(* On every route change: name the tab, then scroll to the #anchor in the URL
   if there is one, or to the top. The scroll waits a tick for the new page. *)
let title_of route =
  match route with
  | "/" -> {js|reativa — reactive web interfaces for OCaml and ReasonML|js}
  | "/examples" -> {js|Examples — reativa|js}
  | path -> (
      match Docs_index.find path with
      | Some page -> page.Docs_index.heading ^ {js| — reativa|js}
      | None -> {js|Not found — reativa|js})

let () =
  Effect.run (fun () ->
    let route = Signal.get Site.route in
    Site.set_document_title (title_of route);
    Site.set_timeout
      (fun () ->
        let hash = (Signal.peek (Router.location ())).hash in
        let target =
          if String.length hash > 1 then
            Site.element_by_id (String.sub hash 1 (String.length hash - 1))
          else None
        in
        match target with
        | Some el -> Site.scroll_into_view el
        | None -> Site.scroll_to 0. 0.)
      0;
    None)

(* ----- header and footer ----- *)

let header () =
  <header className="topbar">
    <div className="topbar-inner">
      (Site.link ~className:"brand" "/"
         [ <span className="brand-mark" />; <span className="brand-name">("reativa")</span> ])
      <nav className="topnav" aria_label="Primary">
        (Site.nav_link ~exact:false "/docs" [ text "Docs" ])
        (Site.nav_link "/examples" [ text "Examples" ])
        (Site.nav_link "/docs/api" [ text "API" ])
        (Site.nav_link "/docs/whats-new" [ text "What's new" ])
      </nav>
      <div className="syntax-toggle" aria_label="Code syntax">
        <button
          className=(if Signal.get Site.syntax = Site.OCaml then "syntax-opt is-active" else "syntax-opt")
          aria_label="Show OCaml syntax"
          onClick=(fun _ -> Signal.set Site.syntax Site.OCaml)
        >
          ("OCaml")
        </button>
        <button
          className=(if Signal.get Site.syntax = Site.Reason then "syntax-opt is-active" else "syntax-opt")
          aria_label="Show ReasonML syntax"
          onClick=(fun _ -> Signal.set Site.syntax Site.Reason)
        >
          ("ReasonML")
        </button>
      </div>
      <button className="theme-btn" aria_label="Toggle color theme" onClick=Site.toggle_theme>
        (if Signal.get Site.theme = Site.Dark then {js|☀|js} else {js|☾|js})
      </button>
      <a className="nav-github" href=(Site.github)>("GitHub")</a>
    </div>
  </header>

let footer_col title links =
  <div className="footer-col">
    <p className="footer-col-title">(title)</p>
    (View.fragment (List.map (fun (path, label) -> Site.link path [ text label ]) links))
  </div>

let footer () =
  <footer className="footer">
    <div className="footer-inner">
      <div className="footer-brand">
        (Site.link ~className:"brand" "/"
           [ <span className="brand-mark" />; <span className="brand-name">("reativa")</span> ])
        <p>("Fine-grained reactive interfaces for OCaml and ReasonML.")</p>
      </div>
      <nav className="footer-sitemap" aria_label="Sitemap">
        (footer_col "Start"
           [
             ("/docs", "Introduction");
             ("/docs/quick-start", "Quick start");
             ("/docs/thinking-in-signals", "Thinking in signals");
             ("/examples", "Examples");
           ])
        (footer_col "Learn"
           [
             ("/docs/learn/signals", "Signals");
             ("/docs/learn/markup", "Markup and components");
             ("/docs/learn/lists", "Lists");
             ("/docs/learn/async-data", "Async data");
           ])
        (footer_col "Reference"
           [
             ("/docs/api", "API reference");
             ("/docs/backends", "Backends");
             ("/docs/devtools", "Devtools");
             ("/docs/whats-new", "What's new in 2.0");
           ])
        <div className="footer-col">
          <p className="footer-col-title">("Project")</p>
          <a href=(Site.github)>("GitHub")</a>
          <a href=(Site.github ^ "/issues")>("Issues")</a>
          <a href=(Site.base ^ "/llms.txt")>("llms.txt")</a>
          <a href=(Site.github ^ "/tree/main/website/src")>("This site's source")</a>
        </div>
      </nav>
      <div className="footer-bottom">
        <p>({js|MIT © Bernardo Gurgel. This site is written in reativa.|js})</p>
        <p>
          ("Inspired by ")
          <a href="https://github.com/brnrdog/xote">("xote")</a>
          (" and ")
          <a href="https://github.com/brnrdog/rescript-signals">("rescript-signals")</a>
          (".")
        </p>
      </div>
    </div>
  </footer>

let () =
  View.mount_by_id "app"
    <div className="site">
      (header ())
      <main className="page">(outlet ())</main>
      (footer ())
    </div>
