; The Reativa demos, built with the js_of_ocaml backend.
;
; Backend selection is the [reativa-jsoo] entry below: it implements the [Dom]
; and [History] virtual modules that the core library leaves abstract. See
; README.md in this directory.
;
; Gated behind REATIVA_JSOO=enabled so a plain `dune build` never requires
; js_of_ocaml to be installed.

; The todo demo lives in a `melange.emit` directory rather than a library, so
; there is nothing to depend on — it is the one source still copied.
(copy_files# ../../demo/ui/todo.mlx)

(executables
 (names todo router_demo)
 (modes js)
 (enabled_if
  (= %{env:REATIVA_JSOO=} enabled))
 (libraries reativa reativa-jsoo)
 (preprocess
  (pps reativa.mlx_ppx)))
